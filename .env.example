# ---------- База данных ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=volleyball_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/volleyball_db

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_WEBAPP_URL=https://your-domain.com/miniapp

# ---------- Payments ----------
PAYMENT_PROVIDER_KEY=YOUR_PAYMENT_KEY_HERE
PAYMENT_PROVIDER_SECRET=YOUR_PAYMENT_SECRET_HERE

# ---------- Общие ----------
ENVIRONMENT=development
