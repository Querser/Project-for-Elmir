# ---------- База данных ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=volleyball_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/volleyball_db

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_NAME=MosVolley
TELEGRAM_WEBAPP_URL=https://your-domain.com/
TELEGRAM_ADMIN_WEBAPP_URL=https://your-domain.com/admin/
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_BOT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ---------- Single-domain gateway ----------
GATEWAY_PORT=8080
ADMIN_BASE_PATH=/admin/

# ---------- Payments ----------
PAYMENT_PROVIDER_KEY=YOUR_PAYMENT_KEY_HERE
PAYMENT_PROVIDER_SECRET=YOUR_PAYMENT_SECRET_HERE
PAYMENT_RETURN_URL=https://your-domain.com/

# ---------- Общие ----------
ENVIRONMENT=development
ALLOW_TELEGRAM_ID_HEADER_AUTH=1
APP_LOG_FILE=backend/logs/app.log
