# Domain for public access (must point A-record to VPS public IP)
DOMAIN=previewsite-nikolaev.ru

# Database
POSTGRES_USER=volleyball
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=volleyball_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://volleyball:CHANGE_ME_DB_PASSWORD@db:5432/volleyball_db

# App mode
ENVIRONMENT=production
RUN_MIGRATIONS_ON_STARTUP=1

# Security (prod must be 0/empty for dev shortcuts)
ALLOW_INSECURE_HEADER_AUTH=0
DEV_AUTO_CREATE_USER_FROM_HEADER=0
DEV_DEFAULT_TELEGRAM_ID=
DEV_ADMIN_TELEGRAM_IDS=

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_TOKEN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_MIN_64_CHARS
ADMIN_ACCESS_TOKEN_TTL_MINUTES=30
ADMIN_REFRESH_TOKEN_TTL_DAYS=14
ADMIN_TOKEN_VERSION=1
SECRET_KEY=CHANGE_ME_OPTIONAL_SECRET_KEY

# Admin frontend base path
ADMIN_BASE_PATH=/admin/

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBAPP_URL=https://previewsite-nikolaev.ru/
TELEGRAM_ADMIN_WEBAPP_URL=https://previewsite-nikolaev.ru/admin/
TELEGRAM_WEBHOOK_URL=https://previewsite-nikolaev.ru/api/v1/telegram/webhook
TELEGRAM_BOT_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET

# Payments
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
