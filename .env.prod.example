# Domain for public access (must point A-record to VPS public IP)
DOMAIN=previewsite-nikolaev.ru

# Database
POSTGRES_USER=volleyball
POSTGRES_PASSWORD=postgres
POSTGRES_DB=volleyball_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://volleyball:postgres@db:5432/volleyball_db

# App mode
ENVIRONMENT=production
RUN_MIGRATIONS_ON_STARTUP=1

# Security (prod must be 0/empty for dev shortcuts)
ALLOW_INSECURE_HEADER_AUTH=0
DEV_AUTO_CREATE_USER_FROM_HEADER=0
DEV_DEFAULT_TELEGRAM_ID=1242542667
DEV_ADMIN_TELEGRAM_IDS=1242542667

